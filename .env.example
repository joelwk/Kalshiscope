# xAI Grok Configuration
# Get your API key from https://console.x.ai
XAI_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-4-1-fast-reasoning
GROK_MODEL_DEEP=grok-4.20-beta-0309-reasoning
# xAI timeout for creating requests and responses
XAI_CLIENT_TIMEOUT_SECONDS=120
# Hard timeout for a single streamed Grok response (cycle 1 review observed
# weather analyses timing out at exactly 100s; 120s now matches the deep/
# crypto/weather ceiling and gives headroom for the observed p95).
GROK_STREAM_TIMEOUT_SECONDS=120
# Per-attempt timeout for deep refinement (richer prompts; legitimate runs
# on slow markets like KXINXU need ~75-90s). Set to 0 to fall back to the
# initial timeout above.
GROK_STREAM_TIMEOUT_SECONDS_DEEP=120
# Extended timeout for crypto-profile markets (higher due to data-heavy prompts)
GROK_STREAM_TIMEOUT_SECONDS_CRYPTO=120
# Extended timeout for weather-profile markets (data-heavy NWS observations).
# Falls back to GROK_STREAM_TIMEOUT_SECONDS when 0 or unset.
GROK_STREAM_TIMEOUT_SECONDS_WEATHER=120
# Total retry budget per market analysis call (must exceed stream timeout for
# retry headroom: 3 * 120s + 2 * 2s = 364s; 400s leaves room for parsing).
GROK_ANALYSIS_MAX_BUDGET_SECONDS=400

# Kalshi API Configuration
KALSHI_API_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=your_kalshi_api_key_id_here
KALSHI_PRIVATE_KEY_PATH=kalshi-scope.txt
# Attempt server-side close-time filtering on market fetch (auto-fallback if unsupported)
KALSHI_SERVER_SIDE_FILTERS_ENABLED=true
# Hard cap on paginated market fetch requests per cycle (0 = unlimited; use
# MARKET_MAX_CLOSE_DAYS to scope). Cycle 2 follow-up found the first 30 pages
# were dominated by KXMVE combo markets, so KALSHI_MVE_FILTER below drops
# them server-side. Bumped to 50 to cover the full non-MVE window in a
# single cycle; KALSHI_ELIGIBLE_FLOOR + the cycle receipt page_cap_hit field
# will signal if 50 still under-covers the catalog.
KALSHI_MAX_FETCH_PAGES=50
# Server-side multivariate-event filter for /markets. "exclude" drops the
# KXMVE combo markets (cycle 2 review found they dominate catalog ordering
# and starve the page cap), "only" returns only combo markets, empty reverts
# to the Kalshi default (include both).
KALSHI_MVE_FILTER=exclude
# Floor on eligible_markets per cycle: below this value with the page cap hit,
# the bot logs a structured WARNING so operators can detect catalog-coverage
# gaps before they manifest as sustained zero-yield ERRORs.
KALSHI_ELIGIBLE_FLOOR=100
# Reserved for the future adaptive top-up path: when true, the bot will
# automatically issue a one-shot follow-up fetch with a doubled cap when the
# eligible floor is missed. Default false: observe the warnings first.
KALSHI_FETCH_TOPUP_ENABLED=false

# Risk Management Configuration
HIGH_CONFIDENCE_POSITION_OVERRIDE=0.85
# Minimum confidence threshold (0.0 to 1.0) to execute trades
MIN_CONFIDENCE=0.62
# Confidence-gate override when edge and evidence are both strong
CONFIDENCE_GATE_EDGE_OVERRIDE_ENABLED=true
CONFIDENCE_GATE_MIN_EDGE=0.10
CONFIDENCE_GATE_MIN_EVIDENCE_QUALITY=0.70
# NOTE: code default is 0.58; this env value (0.62) is the operator-tuned
# stricter override. Lower it for more aggressive confidence-gate activation.
CONFIDENCE_GATE_OVERRIDE_MIN_CONFIDENCE=0.62
# Hard floor: skip execution when evidence quality is below this threshold.
# Matches code default (0.75); raise to require stronger evidence.
MIN_EVIDENCE_QUALITY_FOR_TRADE=0.75
SCORE_LOW_INFO_PENALTY_THRESHOLD=0.60
SCORE_LOW_INFO_PENALTY_BASE=0.12
# Weather-specific evidence floor (applied when market family is weather)
WEATHER_MIN_EVIDENCE_QUALITY=0.50
# Trusted direct-source floors (applied only for direct evidence with whitelisted primary_source_url)
DIRECT_SOURCE_MIN_EVIDENCE_QUALITY_WEATHER=0.72
DIRECT_SOURCE_MIN_EVIDENCE_QUALITY_DEFAULT=0.75
DIRECT_SOURCE_WHITELIST=drudgereport.com,zerohedge.com,weather.gov,noaa.gov,wsj.com,bloomberg.com,reuters.com,coindesk.com,kalshi.com,apnews.com,espn.com,mlb.com,nfl.com,nba.com,nhl.com,billboard.com,hitsdailydouble.com,luminate.com
# Minimum evidence quality for fallback-edge trades (no bookmaker odds found).
# Bypassed when evidence_basis=direct AND verifiable source signal AND evidence_quality>=0.65
GROK_FALLBACK_MIN_EVIDENCE_QUALITY=0.45
# Allow high-confidence, high-edge, source-verifiable analyses to bypass fallback evidence caps
EVIDENCE_QUALITY_HIGH_CONFIDENCE_OVERRIDE=false
# Cap confidence for proxy-evidence fallback-edge trades
GROK_PROXY_CONFIDENCE_CAP=0.78
# Cap confidence when low-information + fallback edge
GROK_LOW_INFO_CONFIDENCE_CAP=0.70
# Evidence threshold below which the bot abstains entirely
GROK_ABSTAIN_EVIDENCE_THRESHOLD=0.35
# Minimum market liquidity in USDC to consider
MIN_LIQUIDITY_USDC=15.0
# Polling interval in seconds (how often to check markets)
POLL_INTERVAL_SEC=300
# Enable adaptive 2x backoff after three zero-order cycles
DRY_STREAK_SLEEP_ENABLED=true

# Edge gating
# Global minimum edge required for any trade
MIN_EDGE=0.12
# Hard sanity cap on model-vs-market edge to avoid hallucinated opportunities.
# Raised from 0.32 to 0.40 after cycle 1 review: a direct, settlement-aligned
# music chart trade with edge=0.56 was hard-blocked before its score could
# be evaluated. 0.40 still rejects clearly-implausible 50pp+ edges while
# allowing high-quality direct evidence to clear into the score gate where
# stacked penalties continue to scale.
MAX_REASONABLE_EDGE=0.40
# Raised cap for definitive-outcome markets (game already settled per primary
# source) and high-quality direct settlement-aligned markets (chart data with
# whitelisted source + evidence_quality>=0.95).
DEFINITIVE_OUTCOME_EDGE_REASONABLE_MAX=0.50
# Floor evidence_quality for definitive outcomes with whitelisted URL + direct basis
# (raised to 0.80 to trigger SCORE_GATE_THRESHOLD_DIRECT_HIGH_QUALITY=0.30 path)
DEFINITIVE_OUTCOME_EVIDENCE_QUALITY_FLOOR=0.80
# Minimum evidence_quality for the high-quality settlement-aligned exemption
# used by the edge gate and hallucinated_edge penalty suppression. The
# exemption recognizes direct + settlement_aligned + whitelisted-source
# evidence without requiring definitive_outcome_detected=True; the strict eq
# floor (default 0.95) compensates by demanding near-perfect evidence quality.
HIGH_QUALITY_SETTLED_EVIDENCE_MIN_EQ=0.95
# Require direct evidence on non-sports markets before execution
NON_SPORTS_REQUIRES_DIRECT_EVIDENCE=true
# Require a populated primary_source_url for non-sports should_trade decisions
NON_SPORTS_REQUIRES_PRIMARY_SOURCE_URL=true
# Outcomes below this probability face a higher edge requirement
LOW_PRICE_THRESHOLD=0.50
VERY_LOW_PRICE_THRESHOLD=0.25
# Minimum edge required for outcomes below LOW_PRICE_THRESHOLD
LOW_PRICE_MIN_EDGE=0.18
# Minimum edge required for outcomes below VERY_LOW_PRICE_THRESHOLD
VERY_LOW_PRICE_MIN_EDGE=0.28
# Near-coinflip zone: prices in this band face higher edge + pre-analysis penalty
COINFLIP_PRICE_LOWER=0.48
COINFLIP_PRICE_UPPER=0.52
# Minimum edge when edge_source=fallback (no external odds found)
FALLBACK_EDGE_MIN_EDGE=0.30
# Minimum edge for weather markets
WEATHER_MIN_EDGE=0.12
# Stricter minimum edge when edge_source=fallback on weather markets
WEATHER_FALLBACK_EDGE_MIN_EDGE=0.34

# Market Filtering
# Comma-separated list of allowed categories (empty = all)
MARKET_CATEGORIES_ALLOWLIST=
# Comma-separated list of blocked categories (matches raw Kalshi category AND inferred market family)
MARKET_CATEGORIES_BLOCKLIST=
# Comma-separated list of blocked inferred market families (weather, crypto, speech, etc)
MARKET_FAMILY_BLOCKLIST=
# Comma-separated ticker prefixes to unconditionally skip (empty = analyze every ticker; dynamic gates still apply)
MARKET_TICKER_BLOCKLIST_PREFIXES=
# Unconditionally skip narrow crypto bin markets (BTC/ETH range bins); leave false to let dynamic gates evaluate them
CRYPTO_BIN_MARKET_BLOCKLIST_ENABLED=false
# Unconditionally skip Kalshi weather "bin" range contracts; leave false to let dynamic gates evaluate them
SKIP_WEATHER_BIN_MARKETS=false
# Minimum trailing 24h volume required (0 disables this filter)
MIN_VOLUME_24H=10
MIN_OPEN_INTEREST=25
# Skip extreme YES-priced markets to avoid low-information tails
EXTREME_YES_PRICE_LOWER=0.02
EXTREME_YES_PRICE_UPPER=0.98
# Hard reject near-certain markets where execution/edge is typically poor
MIN_TRADEABLE_IMPLIED_PRICE=0.12
MAX_TRADEABLE_IMPLIED_PRICE=0.95
# Collapse large event ladders (e.g., crypto range brackets)
LADDER_COLLAPSE_THRESHOLD=3
MAX_BRACKETS_PER_EVENT=3

# Execution Mode
# Set to false to execute real trades (use with caution!)
DRY_RUN=false
POSITION_SYNC_ENABLED=true
POSITION_SYNC_INTERVAL_CYCLES=3
# Refresh market data before order submission; when refresh fails, a lenient fallback
# allows proceeding with stale data (up to 2.5x MAX_MARKET_DATA_AGE_SECONDS) when
# evidence_basis is direct and score passes the gate threshold.
PRE_ORDER_MARKET_REFRESH=true
MAX_MARKET_DATA_AGE_SECONDS=120
ORDERBOOK_PRECHECK_ENABLED=true
ORDERBOOK_PRECHECK_MIN_CONFIDENCE=0.75
ORDERBOOK_MIN_RESTING_VOLUME=3
ORDER_PRICE_IMPROVEMENT_CENTS=1
ORDER_DEFAULT_TIF=gtc
# Do not submit orders at extreme unfillable prices
ORDER_SUBMISSION_MIN_PRICE=0.03
ORDER_SUBMISSION_MAX_PRICE=0.97
# Retry at market price when limit order is canceled unfilled (high-confidence only)
ORDER_FALLBACK_TO_MARKET=true
ORDER_FALLBACK_MIN_CONFIDENCE=0.85
ORDER_FALLBACK_MIN_LIQUIDITY_USDC=200

# Bet sizing
MIN_BET_USDC=2
MAX_BET_USDC=12

# Position limits
# Max single-market exposure as fraction of available bankroll (0.15 = 15%)
MAX_POSITION_PCT_OF_BANKROLL=0.15
# Block position re-add when market price hasn't moved enough since last entry
MIN_PRICE_MOVE_FOR_READD=0.05

# Only bet on markets closing within this window
MARKET_MIN_CLOSE_DAYS=0
MARKET_MAX_CLOSE_DAYS=7

# Score gate mode: off | shadow | active
SCORE_GATE_MODE=active
SCORE_GATE_THRESHOLD=0.52
SCORE_REPEATED_ANALYSIS_PENALTY_BASE=0.25
SCORE_REPEATED_ANALYSIS_PENALTY_START_COUNT=1
SCORE_CONFIDENCE_CALIBRATION_FLOOR=0.78
SCORE_CONFIDENCE_CALIBRATION_PENALTY_SCALE=0.50
SCORE_GATE_THRESHOLD_DIRECT_HIGH_QUALITY=0.30
# Confidence shrinkage toward neutral (direct evidence gets 1.5x factor with raised floor;
# definitive outcomes with likelihood_ratio>=10 get 2.5x factor, preserving near-raw confidence)
CONFIDENCE_SHRINKAGE_FLOOR=0.55
CONFIDENCE_SHRINKAGE_FACTOR=0.50
CALIBRATION_DIRECT_SHRINKAGE_FACTOR_BOOST=2.0
HISTORICAL_CONFIDENCE_SHRINK_ENABLED=true
HISTORICAL_CONFIDENCE_SHRINK_MIN_SAMPLES=15
HISTORICAL_CONFIDENCE_SHRINK_LOOKBACK_DAYS=30
SCORE_FALLBACK_EDGE_PENALTY_BASE=0.12
SCORE_COMPUTED_EDGE_BONUS=0.03
SCORE_PROXY_EVIDENCE_PENALTY_BASE=0.09
SCORE_HALLUCINATED_EDGE_PENALTY_BASE=0.22
SCORE_EXTREME_MARKET_EDGE_PENALTY_BASE=0.08
SCORE_LATE_STAGE_OVERCONFIDENCE_PENALTY_BASE=0.08
MENTION_MARKET_SCORE_PENALTY=0.10
PRE_ANALYSIS_OPPORTUNITY_ENABLED=true
# Calibration note: lowered from 0.60 to 0.55 after removing static ticker
# blocklists and the MLB priority bonus, which together pushed the score
# distribution downward and caused sustained zero-execution-yield cycles
# (best candidate scores topped out at 0.60 with most candidates in
# [0.40, 0.55)). Lower further only if the soft-research learning queue
# is being processed effectively. Keep RESEARCH_BAND wide enough that the
# queue stays a learning surface.
PRE_ANALYSIS_OPPORTUNITY_MIN_SCORE=0.55
PRE_ANALYSIS_OPPORTUNITY_RESEARCH_BAND=0.20
PRE_ANALYSIS_OPPORTUNITY_RESEARCH_ENABLED=true
# Adaptive widening of the soft-research routing band when sustained zero-
# execution cycles indicate calibration drift. Only widens the routing band
# (more markets captured for learning); the deep-analysis MIN_SCORE itself is
# NEVER moved by this knob, so execution gating stays unchanged. The widening
# is linear: per cycle beyond 2 * CYCLE_YIELD_ALERT_ESCALATE_AFTER consecutive
# zero-execution cycles, the band grows by 0.02 up to BAND_MAX.
PRE_ANALYSIS_OPPORTUNITY_RESEARCH_BAND_ADAPTIVE_ENABLED=true
PRE_ANALYSIS_OPPORTUNITY_RESEARCH_BAND_MAX=0.30
MAX_LIFETIME_ANALYSES_PER_MARKET=8
MAX_GLOBAL_CONFIDENCE_DIRECT=0.89
PRE_ANALYSIS_NON_ACTIONABLE_STREAK_PENALTY=0.25
PRE_ANALYSIS_ANALYSIS_COUNT_PENALTY=0.15
PRE_ANALYSIS_FALLBACK_FAMILY_RATE_THRESHOLD=0.80
PRE_ANALYSIS_FALLBACK_FAMILY_PENALTY=0.12
PRE_ANALYSIS_FALLBACK_FAMILY_MIN_SAMPLES=20
PRE_ANALYSIS_HISTORICAL_FAMILY_MIN_SAMPLES=10
PRE_ANALYSIS_HISTORICAL_FAMILY_WIN_RATE_THRESHOLD=0.45
PRE_ANALYSIS_HISTORICAL_FAMILY_PENALTY=0.12
PRE_ANALYSIS_HISTORICAL_FAMILY_PNL_MIN_SAMPLES=20
PRE_ANALYSIS_HISTORICAL_FAMILY_PNL_THRESHOLD=-5
PRE_ANALYSIS_HISTORICAL_FAMILY_PNL_PENALTY=0.10
PRE_ANALYSIS_ZERO_TRADE_RATE_PENALTY=0.04
# Pre-analysis: post-event markets (close_time in past 0-6h) get +0.10 bonus to
# prioritize definitive-outcome opportunities; fallback-family penalty is halved
# when the family has positive PnL and >55% win rate.
# Pre-analysis participation gating (legacy name: PRE_ANALYSIS_HARD_REJECTION_*).
# These settings actually route markets to research_queue (soft demotion) — they
# do NOT terminally reject. The PRE_ANALYSIS_PARTICIPATION_* names below are the
# preferred aliases; if both are set, PARTICIPATION_* wins. The legacy names
# stay supported so existing .env files keep working without changes.
# PRE_ANALYSIS_PARTICIPATION_FAMILIES is empty by default; populate to opt
# specific families into family-tier soft demotion. Per-prefix and per-family
# historical PnL gates still apply when this list is empty.
PRE_ANALYSIS_PARTICIPATION_GATING_ENABLED=true
PRE_ANALYSIS_PARTICIPATION_MIN_STREAK=3
PRE_ANALYSIS_PARTICIPATION_MIN_ANALYSES=5
PRE_ANALYSIS_PARTICIPATION_FAMILIES=
# Legacy aliases (kept for backward compatibility; remove after operators migrate)
# PRE_ANALYSIS_HARD_REJECTION_ENABLED=true
# PRE_ANALYSIS_HARD_REJECTION_MIN_STREAK=3
# PRE_ANALYSIS_HARD_REJECTION_MIN_ANALYSES=5
# PRE_ANALYSIS_HARD_REJECTION_FAMILIES=
# Block families with zero historical action rate
PRE_ANALYSIS_ZERO_ACTION_FAMILY_BLOCK_ENABLED=true
PRE_ANALYSIS_ZERO_ACTION_FAMILY_MIN_SAMPLES=20
# Severe negative PnL thresholds
PRE_ANALYSIS_HISTORICAL_FAMILY_PNL_SEVERE_THRESHOLD=-15.0
PRE_ANALYSIS_HISTORICAL_FAMILY_PNL_SEVERE_PENALTY=0.15
# Crypto short-circuit: skip expensive Grok calls on historically unprofitable crypto
PRE_ANALYSIS_CRYPTO_NEGATIVE_PNL_BLOCK_ENABLED=true
PRE_ANALYSIS_CRYPTO_NEGATIVE_PNL_THRESHOLD=0.0
PRE_ANALYSIS_CRYPTO_FALLBACK_RATE_BLOCK_THRESHOLD=0.55
PRE_ANALYSIS_CRYPTO_MIN_SAMPLES=20
# Crypto preflight: skip Grok when spot-threshold buffer is too wide (default OFF)
CRYPTO_PREFLIGHT_ENABLED=false
CRYPTO_THRESHOLD_BUFFER_AUTO_NO_TRADE_PCT=0.50
# Historical performance gates (data-driven; no hardcoded ticker lists)
HISTORICAL_TICKER_PREFIX_GATE_ENABLED=true
HISTORICAL_TICKER_PREFIX_LEN=12
HISTORICAL_TICKER_PREFIX_LOOKBACK_DAYS=30
HISTORICAL_TICKER_PREFIX_MIN_SAMPLES=3
# Hard-block requires at least this many samples plus poor observed win-rate,
# poor shrunk PnL/trade, and poor total PnL; smaller samples are soft-demoted.
HISTORICAL_TICKER_PREFIX_HARD_BLOCK_MIN_SAMPLES=20
HISTORICAL_TICKER_PREFIX_PNL_CUTOFF=-2.0
HISTORICAL_TICKER_PREFIX_WIN_RATE_CUTOFF=0.40
# Bayesian shrinkage on prefix PnL (pulls small-sample PnL toward neutral prior)
HISTORICAL_TICKER_PREFIX_SHRINKAGE_ENABLED=true
HISTORICAL_TICKER_PREFIX_PRIOR_WIN_RATE=0.50
HISTORICAL_TICKER_PREFIX_PRIOR_STRENGTH=10.0
# Bayesian-shrunk PnL/trade cutoff for soft-demote (small-sample negative prefix)
HISTORICAL_TICKER_PREFIX_SHRUNK_PNL_CUTOFF=-0.50
# Score penalty applied to soft-demoted historical prefixes.
HISTORICAL_TICKER_PREFIX_SOFT_DEMOTE_SCORE_PENALTY=0.08
HISTORICAL_FAMILY_GATE_ENABLED=true
HISTORICAL_FAMILY_LOOKBACK_DAYS=30
HISTORICAL_FAMILY_MIN_SAMPLES=12
HISTORICAL_FAMILY_PNL_CUTOFF=-12.0
HISTORICAL_FAMILY_WIN_RATE_CUTOFF=0.40
# Additional score penalty for weather-market uncertainty
WEATHER_SCORE_PENALTY=0.12
RESEARCH_QUEUE_ENABLED=true
# Persist research queue entries to SQLite for cross-cycle reuse
RESEARCH_QUEUE_PERSIST_TO_DB=true
RESEARCH_QUEUE_REUSE_LOOKBACK_HOURS=6
RESEARCH_QUEUE_PRIORITY_ENABLED=true
# In-memory cap on the per-cycle research-queue capture log used by
# cycle-receipt telemetry and the "Research queue captured N blocked
# opportunities" log line. The DB persists EVERY entry regardless; this only
# bounds the per-cycle in-memory deque. Raise when triaging large-queue cycles
# or lower to reduce log payload size.
RESEARCH_QUEUE_CYCLE_LOG_MAXLEN=200
# Periodically promote stale research-queued markets back to deep analysis so
# the queue is not a write-only black hole. Forced probes bypass the
# pre-analysis score gate. Conservative defaults: at most one probe per cycle,
# only after the entry has aged at least an hour.
RESEARCH_QUEUE_DRAIN_ENABLED=true
RESEARCH_QUEUE_DRAIN_PER_CYCLE=1
RESEARCH_QUEUE_DRAIN_MIN_AGE_HOURS=1.0
RESEARCH_QUEUE_DRAIN_MAX_AGE_HOURS=12.0
RESEARCH_QUEUE_DRAIN_MIN_PRIORITY=0.55
# Fix zero-action family self-fulfilling loop: use deep-analyzed-only denominator
PRE_ANALYSIS_ZERO_ACTION_FAMILY_USE_DEEP_ANALYZED_DENOMINATOR=true
# Force-probe: allow 1 market per family per day to bypass zero-action gate
PRE_ANALYSIS_ZERO_ACTION_FAMILY_FORCE_PROBE_PER_DAY=1
# Participation tier audit + gating
PARTICIPATION_TIER_AUDIT_ENABLED=true
PARTICIPATION_TIER_GATING_ENABLED=true
# Escalate sustained "0 execution candidates with research_queue >50" warnings
# to ERROR after this many consecutive cycles so predictbot_errors.log captures
# selection-failure regressions. 0 disables escalation.
CYCLE_YIELD_ALERT_ESCALATE_AFTER=2
# Skip Grok analysis when daily drawdown cap is already exceeded; route the
# would-be candidates to research_queue with tier=MONITOR_ONLY to capture
# the conviction signal without spending API tokens on trades that the
# downstream daily-drawdown cap would block anyway.
DAILY_DRAWDOWN_PREFLIGHT_ENABLED=true
# Route Grok timeouts to MONITOR_ONLY instead of silent skip
TIMEOUT_RETRY_AS_MONITOR_ONLY_ENABLED=true
# Strong-direct-evidence confidence override (whitelisted source + high eq + computed edge)
STRONG_EVIDENCE_CONFIDENCE_FLOOR=0.55
STRONG_EVIDENCE_MIN_EVIDENCE_QUALITY=0.85
# Proxy variant: tighter thresholds because settlement hasn't been observed yet.
# Requires whitelisted source + computed edge + eq>=0.95 + |edge|>=0.20 + conf>=floor.
STRONG_EVIDENCE_PROXY_MIN_EVIDENCE_QUALITY=0.95
STRONG_EVIDENCE_PROXY_MIN_EDGE=0.20

# Parallel analysis
PARALLEL_ANALYSIS_ENABLED=true
ANALYSIS_MAX_WORKERS=2
# Hard cap on number of markets analyzed per cycle
MAX_MARKETS_PER_CYCLE=3
# When best pre-analysis score is below this, reduce candidate cap
PRE_ANALYSIS_MUST_ANALYZE_THRESHOLD=0.50
PRE_ANALYSIS_REDUCED_MAX_CANDIDATES=3
# When best score is negative, reduce to 1 probe candidate (saves API spend)
NEGATIVE_BEST_SCORE_DEEP_ANALYSIS_FLOOR=0.05
# Cap weather analysis slots to bias toward fewer, better opportunities
MAX_WEATHER_CANDIDATES_PER_CYCLE=1
# Cap crypto analysis slots to reduce correlated threshold over-trading
MAX_CRYPTO_CANDIDATES_PER_CYCLE=1
# Music/speech caps raised from 1 to 2 after cycle 1 review: the only
# high-conviction trade was a music market and direct evidence is more
# common in these families. Total throughput is still bounded by
# MAX_MARKETS_PER_CYCLE.
MAX_SPEECH_CANDIDATES_PER_CYCLE=2
MAX_MUSIC_CANDIDATES_PER_CYCLE=2
# Stop further analysis attempts after repeated consecutive xAI provider failures
XAI_CIRCUIT_BREAKER_MAX_FAILURES=3
# Pause analysis for this many minutes when xAI returns quota-exhausted errors
XAI_QUOTA_BREAKER_ENABLED=true
XAI_QUOTA_PAUSE_MINUTES=30
# Maximum number of executed trades per cycle (capital concentration)
MAX_TRADES_PER_CYCLE=2
# Per-event concentration cap (e.g. max 2 bets on the same game/event)
MAX_BETS_PER_EVENT=2
# Daily risk guardrails (reset at midnight UTC)
MAX_TRADES_PER_DAY=6
MAX_DAILY_DRAWDOWN_USDC=20.0

# Phase 3: Bayesian + LMSR + Kelly
BAYESIAN_ENABLED=false
# Skip Bayesian update count when reasoning hash hasn't changed between cycles
BAYESIAN_SKIP_STALE_UPDATES=true
LMSR_ENABLED=false
KELLY_SIZING_ENABLED=false

# Bayesian
BAYESIAN_PRIOR_DEFAULT=0.50
BAYESIAN_MIN_UPDATES_FOR_TRADE=1
# Clamp posterior to prevent runaway confidence (e.g. 0.999+)
BAYESIAN_MAX_POSTERIOR=0.90
# Cap posterior uplift above raw model confidence
BAYESIAN_MAX_CONFIDENCE_BOOST=0.15

# LMSR (execution-aware gate)
LMSR_LIQUIDITY_PARAM_B=100000
LMSR_MIN_INEFFICIENCY=0.05

# Kelly
KELLY_FRACTION_DEFAULT=0.25
KELLY_FRACTION_SHORT_HORIZON_HOURS=1
KELLY_FRACTION_SHORT_HORIZON=0.10
# Weather Kelly multiplier applied to horizon-selected Kelly fraction
KELLY_FRACTION_WEATHER=0.50
KELLY_ALLOW_MIN_BET_FLOOR_UPSCALE=false
# Kelly min-bet handling policy: skip | floor | fallback_edge_scaling
KELLY_MIN_BET_POLICY=fallback_edge_scaling
KELLY_MIN_BANKROLL_USDC=40

# Throughput / cadence
REANALYSIS_COOLDOWN_HOURS=6
URGENT_REANALYSIS_COOLDOWN_HOURS=1
URGENT_REANALYSIS_DAYS_BEFORE_CLOSE=1
# Hard cap on Grok analyses per market per UTC day; routes additional attempts to research-only.
# Prevents the "23 analyses on the same intraday strike" pattern. Set to 0 to disable.
MAX_REANALYSES_PER_MARKET_PER_DAY=2
# Comma-separated families to skip the borderline_trade_confidence refinement
# trigger for. Refinement spends ~1.5-2 minutes on a second Grok pass when
# initial should_trade=True with confidence in [0.60, 0.78]; for fast-moving
# sports player props/F5/RFI markets the price moves enough during refinement
# to drop edge below MIN_EDGE, killing the trade. Sports markets have well-
# defined statistical priors so the deep pass adds little new information
# beyond fresher market price. Other refinement triggers (low_evidence_quality,
# missing_implied_probability, high_conf_small_edge, legacy_borderline_urgent)
# still fire for these families. Empty value disables the skip.
REFINEMENT_SKIP_BORDERLINE_FAMILIES=sports

# API cost estimation (per 1K tokens) for cycle receipts and analytics
# Set to your actual xAI model pricing (check console.x.ai for current rates)
API_COST_INPUT_PER_1K_TOKENS_USD=0.003
API_COST_OUTPUT_PER_1K_TOKENS_USD=0.015

# Optional: turn off outside calibration sessions.
# Default ON so daily_tuning_recommendations.py has data to work with.
CALIBRATION_MODE_ENABLED=true

# Definitive-outcome side-conflict override.
# When the bot already has a position on one side of an event but Grok finds
# definitive direct evidence (e.g. AP-confirmed game outcome), allow up to this
# many overrides per cycle. 0 = disabled (always block on side conflict).
MAX_DEFINITIVE_OVERRIDES_PER_CYCLE=2

# Probe-trade path (default OFF — opt-in after observing).
# When enabled, prefixes that fail historical_prefix_small_sample_negative but
# belong to a proven-winning family get upgraded to EXECUTION_ELIGIBLE with the
# bet capped at PROBE_TRADE_MAX_USDC. Lets new prefixes accumulate samples.
PROBE_TRADE_ENABLED=false
PROBE_TRADE_MAX_USDC=1.0

# Confidence caps by category
MAX_GLOBAL_CONFIDENCE=0.80
MAX_SPORTS_CONFIDENCE=0.80
MAX_ESPORTS_CONFIDENCE=0.75
MAX_WEATHER_CONFIDENCE=0.65
MAX_INDEX_CONFIDENCE=0.70
MAX_COMMODITY_CONFIDENCE=0.78
# Sub-family commodity caps (override MAX_COMMODITY_CONFIDENCE for specific sub-families)
MAX_LIVESTOCK_CONFIDENCE=0.65
MAX_HEATING_OIL_CONFIDENCE=0.70
MAX_CORN_CONFIDENCE=0.70
MAX_CRYPTO_CONFIDENCE=0.72
MAX_SPEECH_CONFIDENCE=0.65

# Weather research profile
WEATHER_ALLOWED_DOMAINS=weather.gov,forecast.weather.gov,noaa.gov,tropicaltidbits.com,wunderground.com
WEATHER_ALLOWED_X_HANDLES=NWS,NWSSPC,NHC_Atlantic,NWSChicago,NWSNewYorkNY,NWSLosAngeles,NWSHouston,NWSMiami,weatherchannel

# Speech/event research profile (word-mention markets)
SPEECH_ALLOWED_DOMAINS=c-span.org,youtube.com,whitehouse.gov,pm.gc.ca,parl.ca,politico.com,reuters.com,apnews.com
SPEECH_ALLOWED_X_HANDLES=CSPAN,WhiteHouse,POTUS,CanadianPM,Reuters,AP,politico,CBCNews,BBCWorld,WSJ

# Music/streaming research profile
MUSIC_ALLOWED_DOMAINS=billboard.com,hitsdailydouble.com,luminate.com,spotifycharts.com,chartmasters.org
MUSIC_ALLOWED_X_HANDLES=Billboard,SpotifyCharts,LuminateData,HitsDailyDouble
