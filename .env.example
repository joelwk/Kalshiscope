# xAI Grok Configuration
# Get your API key from https://console.x.ai
XAI_API_KEY=
#GROK_MODEL_DEEP=grok-4.20-beta-0309-reasoning
GROK_MODEL_DEEP=grok-4.3-latest
GROK_MODEL=grok-4-1-fast-reasoning
# Increase Grok call headroom for slower markets/responses.
XAI_CLIENT_TIMEOUT_SECONDS=240
# Heavy-research profiles (weather, commodities/generic) routinely stream for
# 85-100s per the live timing audit (success p95 ~= 95s). Cycle 1 review
# observed KXHIGHTMIN-26MAY03-T71 timing out at exactly 100020ms (= the
# previous 100s cap), so 120s now matches the deep ceiling and gives
# headroom for the observed p95 without clipping legitimate runs.
GROK_STREAM_TIMEOUT_SECONDS=240
# Deep refinement is heavier than initial; align with the crypto timeout so
# commodity/weather deep passes don't hit the 90s cap (observed 90-100s tails).
# Bumped 120 -> 150 after the post-7-cycle-followup audit observed
# KXLOWTLV-26MAY03-B61.5 deep refinement timing out at exactly 120015.76ms
# (= the previous 120s cap) per predictbot_errors.log. _DEEP_ANALYSIS_MAX_ATTEMPTS=1
# is intentional (previous_analysis is the safe fallback per code comment),
# so the timeout itself is the correct lever. 150s matches the crypto
# profile cap already in production.
GROK_STREAM_TIMEOUT_SECONDS_DEEP=240
# Crypto profile bumped from 120 to 150 after the post-cycle-2 follow-up
# observed KXBTC-26MAY0317-B78625 timing out at exactly 120091ms (= the
# previous 120s cap). Crypto markets pull data-heavy spot-price prompts
# that consistently push past the 120s window; 150s adds 30s of headroom
# for the p95 without forcing the costly retry path.
# NOTE: A second BTC timeout (KXBTCD-26MAY0312-T78799.99 at 120013ms) was
# observed in a follow-up run because the bot was started before this
# value was applied — settings are loaded once at bot startup. Any future
# .env change to per-profile timeouts requires a bot restart to take
# effect. Verified via `_resolve_stream_deadline_seconds(crypto)=150.0`.
GROK_STREAM_TIMEOUT_SECONDS_CRYPTO=240
# Weather search profile: matches deep ceiling because cycle 1 logs show
# consistent 95-100s tails on weather analyses. Falls back to the global
# GROK_STREAM_TIMEOUT_SECONDS when unset.
GROK_STREAM_TIMEOUT_SECONDS_WEATHER=240
# Budget must accommodate 3 retries at the largest per-profile cap plus
# retry sleeps. Bumped from 400 to 500 alongside the crypto-150 bump:
# 3 * 150s + 2 * 2s = 454s; 500s leaves room for parsing/validation
# overhead and avoids clipping the final retry on crypto markets.
GROK_ANALYSIS_MAX_BUDGET_SECONDS=600
# Base search keeps the first source tier tight; extended research now rotates
# into fallback tiers using the offsets below instead of reusing the same
# first 5 domains / first 10 handles forever.
SEARCH_PROFILE_MAX_DOMAINS=5
SEARCH_PROFILE_MAX_X_HANDLES=10
EXTENDED_RESEARCH_SOURCE_OFFSET=5
EXTENDED_RESEARCH_X_HANDLE_OFFSET=10
SEARCH_LOOKBACK_SHORT_HOURS=24
SEARCH_LOOKBACK_MEDIUM_HOURS=72
SEARCH_LOOKBACK_LONG_HOURS=168

# Kalshi API Configuration
KALSHI_API_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=kalshi-scope.txt
# Attempt server-side close-time filtering on market fetch (auto-fallback if unsupported)
KALSHI_SERVER_SIDE_FILTERS_ENABLED=true
# Hard cap on paginated market fetch requests per cycle (0 = unlimited).
# Cycle 1 review settled at 30 pages; cycle 2 follow-up found those pages
# were dominated by KXMVE multivariate-event combo markets, so KALSHI_MVE_FILTER
# below now drops them server-side. Bumped to 50 to cover the full non-MVE
# window in a single cycle (estimated ~50K non-MVE markets / 1000 per page).
# Eligible-floor warnings + receipt page_cap_hit field will signal if we
# still need to push higher (e.g. 80) under particular catalog conditions.
KALSHI_MAX_FETCH_PAGES=50
# Server-side multivariate-event filter for /markets. "exclude" drops the
# KXMVE combo markets so the page cap is filled with individual sports/
# weather/crypto/music markets. "only" returns only combo markets. Empty
# value reverts to the Kalshi default (include both).
KALSHI_MVE_FILTER=exclude
# When eligible_markets falls below this floor on a cycle that hit the page
# cap, log a structured WARNING so we can detect "running out of catalog
# before running out of cap" before sustained zero-yield ERRORs fire.
KALSHI_ELIGIBLE_FLOOR=100
# Reserved for the future adaptive top-up path. Keep false until we observe
# the post-MVE-filter baseline; flip to true after a few healthy cycles to
# automate one-shot fetch top-ups when the eligible floor is missed.
KALSHI_FETCH_TOPUP_ENABLED=false

# Risk Management Configuration
HIGH_CONFIDENCE_POSITION_OVERRIDE=0.75
# Minimum confidence threshold (0.0 to 1.0) to execute trades
MIN_CONFIDENCE=0.55
# Confidence-gate override when edge and evidence are both strong
CONFIDENCE_GATE_EDGE_OVERRIDE_ENABLED=true
CONFIDENCE_GATE_MIN_EDGE=0.10
CONFIDENCE_GATE_MIN_EVIDENCE_QUALITY=0.65
# Cycle 4 review: prior value 0.62 was equal to MIN_CONFIDENCE, defeating
# the override path. Lowered to 0.55 so high-edge, high-evidence candidates
# at confidence 0.55-0.62 can clear via edge_default while MIN_CONFIDENCE
# stays the hard gate for the rest.
CONFIDENCE_GATE_OVERRIDE_MIN_CONFIDENCE=0.50
# Hard floor: skip execution when evidence quality is below this threshold
MIN_EVIDENCE_QUALITY_FOR_TRADE=0.65
SPORTS_MIN_EVIDENCE_QUALITY=0.60
WEATHER_MIN_EVIDENCE_QUALITY=0.65
# Trusted direct-source floors (applied only for direct evidence + whitelisted primary_source_url)
DIRECT_SOURCE_MIN_EVIDENCE_QUALITY_WEATHER=0.7
DIRECT_SOURCE_MIN_EVIDENCE_QUALITY_SPORTS=0.60
DIRECT_SOURCE_MIN_EVIDENCE_QUALITY_DEFAULT=0.75
# Whitelisted primary-source domains. A trade with primary_source_url on this
# list AND evidence_basis=direct qualifies for the "direct settlement-aligned"
# evidence path (lower confidence shrinkage, definitive-outcome floors apply).
# Mirrors the top-5 of each family's *_ALLOWED_DOMAINS list so trades grounded
# in resolution-aligned primary sources clear DIRECT_SOURCE_MIN_EVIDENCE_QUALITY
# floors. Order is irrelevant here (membership lookup only).
#
# Weather: weather.gov, api.weather.gov, forecast.weather.gov, ncei.noaa.gov,
#          mesonet.agron.iastate.edu, aviationweather.gov, wpc.ncep.noaa.gov,
#          climate.gov, accuweather.com, weather.com, noaa.gov
# Sports:  espn.com, mlb.com, nba.com, nfl.com, nhl.com, ncaa.com,
#          espncricinfo.com, cricbuzz.com, iplt20.com, koreabaseball.com,
#          baseballsavant.mlb.com, baseball-reference.com,
#          basketball-reference.com, pro-football-reference.com
# Crypto:  coinbase.com, kraken.com, binance.com, coingecko.com, glassnode.com,
#          tradingview.com, etherscan.io, blockchain.com, coindesk.com
# Politics:reuters.com, apnews.com, nytimes.com, silverbulletin.com,
#          realclearpolitics.com, congress.gov, ballotpedia.org, decisiondeskhq.com
# Speech:  c-span.org, whitehouse.gov, transcripts.cnn.com, factbase.com,
#          millercenter.org, congress.gov, presidency.ucsb.edu
# Music:   billboard.com, kworb.net, hitsdailydouble.com, luminate.com,
#          charts.spotify.com, riaa.com, official-charts.com
# Entertainment: netflix.com, top10.netflix.com, flixpatrol.com,
#                boxofficemojo.com, the-numbers.com
# Generic/finance: bloomberg.com, wsj.com, ft.com, tradingeconomics.com,
#                  cnbc.com, marketwatch.com, finance.yahoo.com
DIRECT_SOURCE_WHITELIST=drudgereport.com,zerohedge.com,weather.gov,api.weather.gov,forecast.weather.gov,noaa.gov,ncei.noaa.gov,mesonet.agron.iastate.edu,aviationweather.gov,wpc.ncep.noaa.gov,climate.gov,accuweather.com,weather.com,wsj.com,bloomberg.com,reuters.com,coindesk.com,kalshi.com,apnews.com,espn.com,espncricinfo.com,cricbuzz.com,iplt20.com,koreabaseball.com,mlb.com,baseballsavant.mlb.com,nfl.com,nba.com,nhl.com,ncaa.com,baseball-reference.com,basketball-reference.com,pro-football-reference.com,coinbase.com,kraken.com,binance.com,coingecko.com,glassnode.com,tradingview.com,etherscan.io,blockchain.com,nytimes.com,silverbulletin.com,realclearpolitics.com,congress.gov,ballotpedia.org,decisiondeskhq.com,c-span.org,whitehouse.gov,transcripts.cnn.com,factbase.com,millercenter.org,presidency.ucsb.edu,billboard.com,kworb.net,hitsdailydouble.com,luminate.com,charts.spotify.com,riaa.com,official-charts.com,netflix.com,top10.netflix.com,flixpatrol.com,boxofficemojo.com,the-numbers.com,ft.com,tradingeconomics.com,cnbc.com,marketwatch.com,finance.yahoo.com
# Minimum evidence quality for fallback-edge trades (no bookmaker odds found).
# Bypassed when evidence_basis=direct AND verifiable source signal AND evidence_quality>=0.65
GROK_FALLBACK_MIN_EVIDENCE_QUALITY=0.45
EVIDENCE_QUALITY_HIGH_CONFIDENCE_OVERRIDE=false
# Minimum market liquidity in USDC to consider
MIN_LIQUIDITY_USDC=15.0
# Polling interval in seconds (how often to check markets)
POLL_INTERVAL_SEC=300
# Keep cycles at base cadence during participation tuning; logs showed the
# 2x dry-streak sleep stretching already-slow zero-order sessions to 10 min.
DRY_STREAK_SLEEP_ENABLED=false

# Edge gating
MIN_EDGE=0.12
# Hard sanity cap on model-vs-market edge to catch hallucinated opportunities.
# Raised from 0.32 to 0.40 after cycle 1 review: a direct, settlement-aligned
# music chart trade with edge=0.56 was hard-blocked before its score could
# be evaluated. 0.40 still rejects clearly-implausible 50pp+ edges while
# allowing high-quality direct evidence to clear into the score gate where
# stacked penalties continue to scale.
MAX_REASONABLE_EDGE=0.40
MIN_EDGE_HIGH_LIQUIDITY_THRESHOLD=300.0
MIN_EDGE_HIGH_LIQUIDITY_MULTIPLIER=0.70
MIN_EDGE_MEDIUM_LIQUIDITY_THRESHOLD=100.0
MIN_EDGE_MEDIUM_LIQUIDITY_MULTIPLIER=0.85
# Raised cap for definitive-outcome and high-quality direct settled markets
# (game already settled per primary source, or settlement-aligned chart data
# with whitelisted source + evidence_quality>=0.95).
DEFINITIVE_OUTCOME_EDGE_REASONABLE_MAX=0.50
# Floor evidence_quality for definitive outcomes with whitelisted URL + direct basis
# (raised to 0.80 to trigger SCORE_GATE_THRESHOLD_DIRECT_HIGH_QUALITY=0.30 path)
DEFINITIVE_OUTCOME_EVIDENCE_QUALITY_FLOOR=0.80
# Minimum evidence_quality for the high-quality settlement-aligned exemption
# (direct + settlement_aligned + whitelisted source bypasses MAX_REASONABLE_EDGE
# only when eq >= this floor). 0.95 keeps the safety net tight.
HIGH_QUALITY_SETTLED_EVIDENCE_MIN_EQ=0.95
# Require direct evidence on non-sports markets before execution
NON_SPORTS_REQUIRES_DIRECT_EVIDENCE=false
# Require a populated primary_source_url for non-sports should_trade decisions
NON_SPORTS_REQUIRES_PRIMARY_SOURCE_URL=false
# Outcomes below this probability face a higher edge requirement
LOW_PRICE_THRESHOLD=0.50
LOW_PRICE_MIN_EDGE=0.18
VERY_LOW_PRICE_MIN_EDGE=0.28
LOW_PRICE_MIN_EDGE_MULTIPLIER=0.85
# Near-coinflip zone: prices in this band face higher edge + pre-analysis penalty
COINFLIP_PRICE_LOWER=0.48
COINFLIP_PRICE_UPPER=0.52
# Minimum edge when edge_source=fallback (no external odds found)
FALLBACK_EDGE_MIN_EDGE=0.25
FALLBACK_EDGE_MIN_EDGE_MULTIPLIER=0.90
WEATHER_MIN_EDGE=0.14
WEATHER_FALLBACK_EDGE_MIN_EDGE=0.25

# Market Filtering
# Comma-separated list of allowed categories (empty = all)
MARKET_CATEGORIES_ALLOWLIST=
# Comma-separated list of blocked categories (matches raw Kalshi category AND inferred market family)
MARKET_CATEGORIES_BLOCKLIST=
# Comma-separated list of blocked inferred market families (weather, crypto, speech, etc).
# OPERATING PRINCIPLE: do NOT use this for performance-driven blocking.
# Underperforming families are addressed by improving research sources,
# search profiles, and calibration - never by removing them from analysis.
# Reserved as a last-resort escape hatch for catalog-noise issues that
# survive KALSHI_MVE_FILTER and server-side filters. Empty by default.
MARKET_FAMILY_BLOCKLIST=
# Comma-separated ticker prefixes to unconditionally skip (empty = analyze
# every ticker; dynamic gates still apply). E.g. add "KXMVE" here if the
# server-side KALSHI_MVE_FILTER ever stops working as expected.
MARKET_TICKER_BLOCKLIST_PREFIXES=
# Unconditionally skip narrow crypto bin markets (BTC/ETH range bins);
# false lets dynamic gates (pre-analysis penalties, edge thresholds)
# evaluate them. Conceptually pairs with KALSHI_MVE_FILTER above.
CRYPTO_BIN_MARKET_BLOCKLIST_ENABLED=false
# Unconditionally skip Kalshi weather "bin" range contracts; false lets
# dynamic gates evaluate them.
SKIP_WEATHER_BIN_MARKETS=false
# Minimum trailing 24h volume required (0 disables this filter)
MIN_VOLUME_24H=10
MIN_OPEN_INTEREST=25
# Skip extreme YES-priced tails to avoid low-information markets
EXTREME_YES_PRICE_LOWER=0.02
EXTREME_YES_PRICE_UPPER=0.98
# Hard reject near-certain markets where execution/edge is typically poor.
# Cycle 2 review found this filter was a top-3 rejection bucket
# (skipped_untradeable_price ~2,800 per cycle on the 30K-fetch baseline).
# Surfaced explicitly so operators can tune the tradeable price band when
# re-tuning the catalog funnel after the cycle 2 KALSHI_MVE_FILTER change.
MIN_TRADEABLE_IMPLIED_PRICE=0.12
MAX_TRADEABLE_IMPLIED_PRICE=0.95
# Collapse large event ladders (e.g., crypto price-range brackets)
LADDER_COLLAPSE_THRESHOLD=3
MAX_BRACKETS_PER_EVENT=3

# Execution Mode
# Set to false to execute real trades (use with caution!)
DRY_RUN=false
ORDERBOOK_PRECHECK_ENABLED=true
ORDERBOOK_PRECHECK_MIN_CONFIDENCE=0.75
ORDER_PRICE_IMPROVEMENT_CENTS=1
# Retry at market price when limit order is canceled unfilled (high-confidence only).
# Lowered 0.85 -> 0.75 after the 7-cycle follow-up audit found a definitive-
# outcome KXCOPPERD trade (raw_conf=0.95, edge=49pp, WSJ source) couldn't
# fall back to a market order because MAX_COMMODITY_CONFIDENCE=0.78 capped
# the trade below the 0.85 fallback floor. 0.75 admits commodity-class
# definitive-outcome trades while still rejecting low-conviction (sub-0.75)
# fallbacks. Combined with MAX_COMMODITY_CONFIDENCE 0.78 -> 0.85 below.
ORDER_FALLBACK_TO_MARKET=true
ORDER_FALLBACK_MIN_CONFIDENCE=0.75

# Bet sizing
MIN_BET_USDC=5
MAX_BET_USDC=10

# Only bet on markets closing between 1-7 days from now
MARKET_MIN_CLOSE_DAYS=0
MARKET_MAX_CLOSE_DAYS=5

# Position limits
# Max single-market exposure as fraction of available bankroll (0.25 = 25%)
MAX_POSITION_PCT_OF_BANKROLL=0.25
# Block position re-add when market price hasn't moved enough since last entry
MIN_PRICE_MOVE_FOR_READD=0.05

# Score gate mode: off | shadow | active
SCORE_GATE_MODE=active
SCORE_GATE_THRESHOLD=0.42
SCORE_CONFIDENCE_CALIBRATION_FLOOR=0.72
SCORE_CONFIDENCE_CALIBRATION_PENALTY_SCALE=0.50
SCORE_LOW_INFO_PENALTY_BASE=0.12
SCORE_REPEATED_ANALYSIS_PENALTY_BASE=0.025
SCORE_FALLBACK_EDGE_PENALTY_BASE=0.12
SCORE_COMPUTED_EDGE_BONUS=0.03
SCORE_PROXY_EVIDENCE_PENALTY_BASE=0.11
# Penalize >=35pp hallucinated edge and late-stage overconfidence without direct evidence
SCORE_HALLUCINATED_EDGE_PENALTY_BASE=0.08
SCORE_OVERCONFIDENCE_PENALTY_BASE=0.05
SCORE_GENERIC_BIN_PENALTY_BASE=0.015
SCORE_VOLUME_AMPLIFIER_ENABLED=true
SCORE_EXTREME_MARKET_EDGE_PENALTY_BASE=0.08
SCORE_LATE_STAGE_OVERCONFIDENCE_PENALTY_BASE=0.12
WEATHER_SCORE_PENALTY=0.12
SCORE_GATE_THRESHOLD_WEATHER_DIRECT=0.12
# History: 0.30 -> 0.27 (7-cycle follow-up after the Jose Ramirez settled
# MLB outcome was skipped at score=0.289, gap 0.011) -> 0.25 (post-7-cycle
# audit, this iteration). Loosens definitive-outcome execution by an
# additional 2pp of headroom past calibration penalties. The lowest
# observed score_final on a should_trade=True row in the audited window
# was -0.309 (KXLOWTLV with non_positive_market_edge composite penalties),
# well below 0.25; this change does not admit clearly-bad scores - it just
# gives definitive-outcome trades whose calibrated composite lands in the
# [0.25, 0.27) band a chance to clear the high-quality threshold path.
SCORE_GATE_THRESHOLD_DIRECT_HIGH_QUALITY=0.25
# Confidence shrinkage toward neutral (direct evidence gets 1.5x factor with raised floor;
# definitive outcomes with likelihood_ratio>=10 get 2.5x factor, preserving near-raw confidence)
CONFIDENCE_SHRINKAGE_FLOOR=0.55
CONFIDENCE_SHRINKAGE_FACTOR=0.45
CALIBRATION_DIRECT_SHRINKAGE_FACTOR_BOOST=2.0
HISTORICAL_CONFIDENCE_SHRINK_ENABLED=true
HISTORICAL_CONFIDENCE_SHRINK_MIN_SAMPLES=15
HISTORICAL_CONFIDENCE_SHRINK_LOOKBACK_DAYS=30
# Strong-evidence confidence override (whitelisted source + high eq + computed edge)
STRONG_EVIDENCE_CONFIDENCE_FLOOR=0.55
STRONG_EVIDENCE_MIN_EVIDENCE_QUALITY=0.85
# Proxy variant: tighter thresholds because settlement hasn't been observed yet
STRONG_EVIDENCE_PROXY_MIN_EVIDENCE_QUALITY=0.95
STRONG_EVIDENCE_PROXY_MIN_EDGE=0.20
# Confidence caps by category (tightened after profit-optim pass)
MAX_GLOBAL_CONFIDENCE=0.80
# Floor cap for direct-evidence trades (used by the
# _is_high_quality_settled_evidence path added in the cycle 1 review when
# the trade is not also definitive-outcome eligible). Higher than
# MAX_GLOBAL_CONFIDENCE so direct evidence keeps more of its raw signal.
MAX_GLOBAL_CONFIDENCE_DIRECT=0.89
MAX_WEATHER_CONFIDENCE=0.65
MAX_CRYPTO_CONFIDENCE=0.72
MAX_SPEECH_CONFIDENCE=0.65
# Raised 0.78 -> 0.85 after the 7-cycle follow-up audit found KXCOPPERD-
# 26MAY0417-T5.88 (raw_conf=0.95, edge=49pp, definitive_outcome_detected,
# WSJ primary source) being capped at 0.78 \u2014 below the 0.85
# ORDER_FALLBACK_MIN_CONFIDENCE floor \u2014 so the resting limit order
# couldn't auto-convert to a market order when not filled. 0.85 still
# below MAX_GLOBAL_CONFIDENCE_DIRECT=0.89 so direct-evidence commodity
# trades retain conviction headroom.
MAX_COMMODITY_CONFIDENCE=0.85
# Pre-analysis opportunity filter: lower = more candidates reach Grok.
# History: 0.60 -> 0.55 (cycle 30 audit) -> 0.50 (7-cycle follow-up) ->
# 0.42 (this iteration, post-7-cycle-followup audit).
# The post-tuning 7-cycle run showed pre_score_distribution.p50 = 0.42-0.44
# and p75 = 0.56-0.58 across all 7 cycles. With MIN_SCORE=0.50 only the
# top ~30% of scored markets cleared into Grok analysis (best candidate
# scores topped out at 0.59 in this run). Lowering to 0.42 admits roughly
# the top half of scored markets (median market is now eligible) without
# moving the soft-research band width (still RESEARCH_BAND=0.20, so the
# band shifts to [0.22, 0.42) instead of [0.30, 0.50)). MAX_MARKETS_PER_CYCLE=3
# still caps actual Grok calls per cycle, so this widens the candidate
# *pool* before risk-adjusted ranking, not the analysis budget itself.
# Goes BELOW PRE_ANALYSIS_MUST_ANALYZE_THRESHOLD=0.50 intentionally; the
# dynamic cap-reduction (PRE_ANALYSIS_REDUCED_MAX_CANDIDATES=3 = same as
# default cap) means the floor is now informational rather than punitive.
PRE_ANALYSIS_OPPORTUNITY_MIN_SCORE=0.25
# Soft-research routing band. Markets scoring below MIN_SCORE but within
# [MIN_SCORE - RESEARCH_BAND, MIN_SCORE) are queued for learning instead of
# being skipped. Uses the default of 0.20 (i.e. score >= 0.35 → research-only).
# The deep-analysis MIN_SCORE itself is unchanged when the band widens.
PRE_ANALYSIS_OPPORTUNITY_RESEARCH_BAND=0.20
# Adaptive widening of the soft-research routing band when the bot is in
# sustained zero-execution drought. Only widens the routing band (more
# markets captured for learning); the deep-analysis MIN_SCORE itself is
# NEVER moved by this knob, so execution gating stays unchanged. Linear
# growth: per cycle beyond 2 * CYCLE_YIELD_ALERT_ESCALATE_AFTER consecutive
# zero-execution cycles, band grows by 0.02 up to BAND_MAX. With this
# operator's CYCLE_YIELD_ALERT_ESCALATE_AFTER=6 below, the trigger is at
# 12 consecutive zero-execution cycles (~60 min at 5-min polling).
PRE_ANALYSIS_OPPORTUNITY_RESEARCH_BAND_ADAPTIVE_ENABLED=true
PRE_ANALYSIS_OPPORTUNITY_RESEARCH_BAND_MAX=0.30
# Pre-analysis: post-event markets (close_time in past 0-6h) get +0.10 bonus to
# prioritize definitive-outcome opportunities; fallback-family penalty is halved
# when the family has positive PnL and >55% win rate.
# Pre-analysis participation gating (renamed from HARD_REJECTION; the legacy
# name was misleading because this routes markets to research_queue, not
# terminal reject). New name takes precedence; legacy still works as fallback.
PRE_ANALYSIS_PARTICIPATION_GATING_ENABLED=true
PRE_ANALYSIS_PARTICIPATION_MIN_STREAK=3
PRE_ANALYSIS_PARTICIPATION_MIN_ANALYSES=5
PRE_ANALYSIS_NON_ACTIONABLE_STREAK_PENALTY=0.08
PRE_ANALYSIS_ANALYSIS_COUNT_PENALTY=0.08
PRE_ANALYSIS_HISTORICAL_FAMILY_PNL_MIN_SAMPLES=20
PRE_ANALYSIS_HISTORICAL_FAMILY_PNL_THRESHOLD=-10
PRE_ANALYSIS_HISTORICAL_FAMILY_PNL_PENALTY=0.10
PRE_ANALYSIS_HISTORICAL_FAMILY_PNL_SEVERE_THRESHOLD=-15.0
PRE_ANALYSIS_HISTORICAL_FAMILY_PNL_SEVERE_PENALTY=0.15
PRE_ANALYSIS_ZERO_TRADE_RATE_PENALTY=0.04
# Cap on the combined "stacked historical-family penalty" applied in the
# pre-analysis opportunity score. The fallback-family, historical-family,
# historical-family-PnL, zero-trade-rate, negative-prefix, and historical-gate
# soft-demote score-penalty terms all draw from overlapping historical data
# sources; without a cap a single bad family/prefix can collapse a market's
# pre-analysis score by 0.4-0.5pp via double/triple counting and force soft-
# research routing on otherwise liquid, well-priced near-event markets.
#
# Replay against current decision_receipts (since 2026-05-05): 971 of 2,249
# decisions (43.2%) had the stacked penalty exceeding 0.25, of which 855 were
# routed via pre_analysis_score_soft_research (the dominant zero-execution
# bucket). Capping at 0.25 credits the excess back to the score and lifts
# many of those near-miss markets back into deep-analysis eligibility while
# every individual penalty stays visible in pre_analysis_breakdown.
#
# Set to 0 to disable the cap (legacy behavior). Raise to be more permissive
# (penalties stack further before clipping); lower to be stricter. Receipts
# expose the raw stack, the cap, and the credited excess in the keys
# pre_score_stacked_historical_penalty_raw,
# pre_score_stacked_historical_penalty_cap,
# pre_score_stacked_historical_excess_credited so operators can audit how
# often the cap fired and how much score was credited back per cycle.
PRE_ANALYSIS_STACKED_HISTORICAL_PENALTY_CAP=0.15
# Crypto short-circuit: skip expensive Grok calls on historically unprofitable crypto
PRE_ANALYSIS_CRYPTO_NEGATIVE_PNL_BLOCK_ENABLED=true
PRE_ANALYSIS_CRYPTO_NEGATIVE_PNL_THRESHOLD=0.0
PRE_ANALYSIS_CRYPTO_FALLBACK_RATE_BLOCK_THRESHOLD=0.55
PRE_ANALYSIS_CRYPTO_MIN_SAMPLES=20

# Probe trades: let new prefixes in proven families accumulate samples with $1 cap
PROBE_TRADE_ENABLED=true
PROBE_TRADE_MAX_USDC=1.0

# Crypto preflight: skip Grok when spot-threshold buffer is too wide (default OFF)
CRYPTO_PREFLIGHT_ENABLED=false
CRYPTO_THRESHOLD_BUFFER_AUTO_NO_TRADE_PCT=0.50

# Historical performance gates (data-driven, no hardcoded ticker lists)
HISTORICAL_TICKER_PREFIX_GATE_ENABLED=true
HISTORICAL_TICKER_PREFIX_LEN=12
HISTORICAL_TICKER_PREFIX_LOOKBACK_DAYS=30
HISTORICAL_TICKER_PREFIX_MIN_SAMPLES=3
# Hard-block requires at least this many samples AND the Wilson lower-bound
# on the true win rate to be at or below HISTORICAL_TICKER_PREFIX_WIN_RATE_CUTOFF
# (the same Wilson LB requirement now also applies to the family-level gate).
# Samples below this floor (but above HISTORICAL_TICKER_PREFIX_MIN_SAMPLES)
# soft-demote with a score-penalty proportional to sample weight and never
# hard-block. Combined with the Wilson LB requirement, hard-deny only fires
# when both the observed win rate and its statistical lower bound stay below
# cutoff, so a sufficient-sample prefix with one lucky/unlucky run cannot
# collapse to a hard block on noise alone.
HISTORICAL_TICKER_PREFIX_HARD_BLOCK_MIN_SAMPLES=10
HISTORICAL_TICKER_PREFIX_PNL_CUTOFF=-2.0
HISTORICAL_TICKER_PREFIX_WIN_RATE_CUTOFF=0.40
# Bayesian shrinkage on prefix PnL (pulls small-sample PnL toward neutral prior)
HISTORICAL_TICKER_PREFIX_SHRINKAGE_ENABLED=true
HISTORICAL_TICKER_PREFIX_PRIOR_WIN_RATE=0.50
HISTORICAL_TICKER_PREFIX_PRIOR_STRENGTH=10.0
# Score penalty applied to soft-demoted historical prefixes.
HISTORICAL_TICKER_PREFIX_SOFT_DEMOTE_SCORE_PENALTY=0.08
HISTORICAL_FAMILY_GATE_ENABLED=true
HISTORICAL_FAMILY_LOOKBACK_DAYS=30
HISTORICAL_FAMILY_MIN_SAMPLES=12
HISTORICAL_FAMILY_PNL_CUTOFF=-12.0
HISTORICAL_FAMILY_WIN_RATE_CUTOFF=0.40

# Parallel analysis
PARALLEL_ANALYSIS_ENABLED=true
# Recent Grok p50/p90 were ~65s/~95s; 4 workers keeps 16-candidate cycles
# closer to the old latency while increasing market coverage.
ANALYSIS_MAX_WORKERS=4
RESEARCH_QUEUE_ENABLED=true
# Persist research queue entries to SQLite for cross-cycle reuse
RESEARCH_QUEUE_PERSIST_TO_DB=true
RESEARCH_QUEUE_REUSE_LOOKBACK_HOURS=6
RESEARCH_QUEUE_PRIORITY_ENABLED=true
# In-memory cap on the per-cycle research-queue capture log used by the
# cycle receipt and the "Research queue captured N blocked opportunities"
# log line. The DB persists EVERY entry regardless of this cap. Drives the
# consistent "200 captured" pattern in cycle logs; raise to triage large
# queue cycles or lower to reduce log payload size.
RESEARCH_QUEUE_CYCLE_LOG_MAXLEN=200
# Periodically promote the longest-waiting research-queued markets back to
# deep analysis so the queue is not a write-only black hole. Forced probes
# bypass the pre-analysis score gate. Conservative defaults: 1 probe/cycle
# only after the entry has aged at least an hour and is younger than 12h.
RESEARCH_QUEUE_DRAIN_ENABLED=true
# Cycle 4 review: queue accumulated 127+ entries while drain stayed at 1
# probe per cycle. Raised to 2 so the queue is sampled twice as fast
# without bypassing downstream execution gates.
RESEARCH_QUEUE_DRAIN_PER_CYCLE=8
RESEARCH_QUEUE_DRAIN_MIN_AGE_HOURS=1.0
RESEARCH_QUEUE_DRAIN_MAX_AGE_HOURS=12.0
RESEARCH_QUEUE_DRAIN_FORCE_EXTENDED_RESEARCH=true
# Drain priority floor: queue entries with proxied priority below this cutoff
# are skipped during drain selection (priority = audit.pre_analysis_score
# when present, else 1.0 - threshold_gap). Entries without priority signal
# are admitted as "unknown". Cycle 30 audit fix: this setting was previously
# defined but never enforced in the SQL helper; now actually filters the
# drain pool. Keep aligned with PRE_ANALYSIS_OPPORTUNITY_MIN_SCORE so we
# only re-promote markets that were close to the analysis threshold.
# Recent cycle receipts skipped up to 80 drain rows as low priority while
# zero-execution cycles continued. Set to 0.0 during participation tuning so
# the drain quota actually samples the queue; downstream gates still decide.
RESEARCH_QUEUE_DRAIN_MIN_PRIORITY=0.0
# Participation tier audit + gating
PARTICIPATION_TIER_AUDIT_ENABLED=true
PARTICIPATION_TIER_GATING_ENABLED=true
# Escalate sustained "0 execution candidates with research_queue >50" warnings
# to ERROR after this many consecutive cycles so predictbot_errors.log captures
# selection-failure regressions. 0 disables escalation.
# Re-tuned 2 -> 4 -> 6 -> 4 across audits. 6 was set after observing Grok
# was honestly conservative (raw_should_trade=False) with
# should_trade_but_blocked=0 — but the 7-cycle follow-up showed the
# adaptive band (5e from cycle-30 audit) only fires at
# 2 * CYCLE_YIELD_ALERT_ESCALATE_AFTER consecutive zero-execution cycles,
# i.e. 12 cycles = ~60 min at 5-min polling. Lowering to 4 brings the
# adaptive band trigger to 8 cycles (~40 min) so widening can actually
# kick in during sustained drought. Trade-off: ERROR alerts fire at
# 4 zero cycles instead of 6, increasing log noise during legitimately
# conservative streaks.
CYCLE_YIELD_ALERT_ESCALATE_AFTER=4
# Route Grok timeouts to MONITOR_ONLY instead of silent skip
TIMEOUT_RETRY_AS_MONITOR_ONLY_ENABLED=true
# Hard cap on processed deep-analysis decisions per cycle after prioritization.
# Raised 12 -> 16 alongside ANALYSIS_MAX_WORKERS=4; the recent funnel had
# 650+ eligible candidates/cycle but only 12 reached Grok.
MAX_MARKETS_PER_CYCLE=16
# When best pre-analysis score is below this, reduce candidate cap
PRE_ANALYSIS_MUST_ANALYZE_THRESHOLD=0.30
PRE_ANALYSIS_REDUCED_MAX_CANDIDATES=3
# When best score is negative, reduce to 1 probe candidate (saves API spend)
NEGATIVE_BEST_SCORE_DEEP_ANALYSIS_FLOOR=0.05
MAX_WEATHER_CANDIDATES_PER_CYCLE=2
MAX_CRYPTO_CANDIDATES_PER_CYCLE=2
# Music/speech caps raised from 1 to 2 after cycle 1 review: the only
# high-conviction trade was a music market and direct evidence is more
# common in these families. Total throughput is still bounded by
# MAX_MARKETS_PER_CYCLE.
MAX_MUSIC_CANDIDATES_PER_CYCLE=2
MAX_SPEECH_CANDIDATES_PER_CYCLE=2
# Cycle 4 review: sports props consumed all 6 analysis slots while
# weather/music/generic candidates with direct evidence sat unanalyzed.
# Cap sports at half of MAX_MARKETS_PER_CYCLE so other families always have
# a path to deep analysis when eligible. Set to 0 to disable the cap.
MAX_SPORTS_CANDIDATES_PER_CYCLE=5
XAI_CIRCUIT_BREAKER_MAX_FAILURES=3
# Pause analysis for N minutes when xAI returns quota-exhausted errors
XAI_QUOTA_BREAKER_ENABLED=true
XAI_QUOTA_PAUSE_MINUTES=30
# Maximum number of executed trades per cycle (capital concentration)
MAX_TRADES_PER_CYCLE=3
# Per-event concentration cap (e.g. max 2 bets on the same game/event)
MAX_BETS_PER_EVENT=2
# Daily risk guardrails (reset at midnight UTC)
MAX_TRADES_PER_DAY=12
MAX_DAILY_DRAWDOWN_USDC=50.0
# Skip Grok analysis when daily drawdown cap is already exceeded; route the
# would-be candidates to research_queue with tier=MONITOR_ONLY to capture the
# conviction signal without paying for trades that the same cap would block.
DAILY_DRAWDOWN_PREFLIGHT_ENABLED=true

# Phase 3 (post-fix): Bayesian + LMSR + Kelly
BAYESIAN_ENABLED=true
LMSR_ENABLED=true
KELLY_SIZING_ENABLED=true

# Bayesian
BAYESIAN_PRIOR_DEFAULT=0.50
BAYESIAN_MIN_UPDATES_FOR_TRADE=1
# Clamp posterior to prevent runaway confidence (e.g. 0.999+)
BAYESIAN_MAX_POSTERIOR=0.97

# LMSR (execution-aware gate)
LMSR_LIQUIDITY_PARAM_B=100000
LMSR_MIN_INEFFICIENCY=0.03

# Kelly
KELLY_DYNAMIC_ENABLED=true
KELLY_FRACTION_DEFAULT=0.45
KELLY_FRACTION_SHORT_HORIZON_HOURS=1
KELLY_FRACTION_SHORT_HORIZON=0.10
# Kelly min-bet handling policy: skip | floor | fallback_edge_scaling
# fallback_edge_scaling preserves Kelly as primary sizing and falls back to
# edge-scaling sizing when Kelly is below MIN_BET_USDC.
KELLY_MIN_BET_POLICY=fallback_edge_scaling
KELLY_MIN_BANKROLL_USDC=50

# Throughput / cadence
REANALYSIS_COOLDOWN_HOURS=2
URGENT_REANALYSIS_COOLDOWN_HOURS=0
URGENT_REANALYSIS_DAYS_BEFORE_CLOSE=1
# Hard cap on Grok analyses per market per UTC day; routes additional attempts
# to research-only. Prevents the "23 analyses on the same intraday strike"
# pattern. Set to 0 to disable. Cycle 1 logs showed multiple retry attempts
# on the same Minneapolis weather market after a stream timeout.
MAX_REANALYSES_PER_MARKET_PER_DAY=2
# Lifetime cap on total Grok analyses for a given market (across all days).
MAX_LIFETIME_ANALYSES_PER_MARKET=8
# Comma-separated families to skip the borderline_trade_confidence refinement
# trigger for. Added after the post-7-cycle-followup audit found
# KXMLBF5-26MAY041840TORTB-TB initial trade=True (conf=0.62, edge>=0.08)
# downgraded to trade=False (conf=0.50, edge=0.04) by deep refinement after
# ~2 minutes of MLB market price movement. Sports markets move too fast for
# the refinement window to add value. Other refinement triggers (low_evidence
# _quality, missing_implied_probability, high_conf_small_edge, legacy_
# borderline_urgent) still fire for these families.
REFINEMENT_SKIP_BORDERLINE_FAMILIES=sports

# Optional: turn off outside calibration sessions
CALIBRATION_MODE_ENABLED=false

# xAI API cost tracking (per 1K tokens)
# grok-4-1-fast-reasoning: input=$0.003/1K, output=$0.015/1K (verify at console.x.ai)
API_COST_INPUT_PER_1K_TOKENS_USD=0.003  
API_COST_OUTPUT_PER_1K_TOKENS_USD=0.015

# =============================================================================
# Research-profile source whitelists.
#
# Grok consults these domains/handles when assembling primary-source evidence
# for the corresponding market family. Lists are ORDER-SENSITIVE because
# research_profiles.py trims to SEARCH_PROFILE_MAX_DOMAINS domains and
# SEARCH_PROFILE_MAX_X_HANDLES handles per search; everything beyond those caps
# rotates in only when the profile widens (e.g. extended-research path).
#
# Operating principle: NEVER block families to fix performance. Instead, lift
# the floor by giving Grok better, more-creative primary sources so its
# direct-evidence path can clear DIRECT_SOURCE_MIN_EVIDENCE_QUALITY_*.
# =============================================================================

# -----------------------------------------------------------------------------
# Music / streaming research profile (Billboard chart, Spotify Top, album sales)
# -----------------------------------------------------------------------------
# Top 5 (resolution-aligned for Kalshi music markets):
#   billboard.com         - official Billboard chart pages (resolution source)
#   kworb.net             - deep streaming analytics + projections (creative)
#   hitsdailydouble.com   - first-week sales / chart projections (whitelisted)
#   luminate.com          - Luminate (chart data provider Kalshi cites)
#   charts.spotify.com    - Spotify Top 50 / Daily Global / Daily by-country
# Fallback:
#   spotifycharts.com, chartmasters.org, music.apple.com (Apple charts),
#   official-charts.com (UK), riaa.com (certifications), variety.com,
#   rollingstone.com, mediabase.com (radio), pitchfork.com (reviews),
#   musicbusinessworldwide.com (industry news)
MUSIC_ALLOWED_DOMAINS=billboard.com,kworb.net,hitsdailydouble.com,luminate.com,charts.spotify.com,spotifycharts.com,chartmasters.org,music.apple.com,official-charts.com,riaa.com,variety.com,rollingstone.com,mediabase.com,pitchfork.com,musicbusinessworldwide.com
MUSIC_ALLOWED_X_HANDLES=Billboard,SpotifyCharts,LuminateData,HitsDailyDouble,kworb_,billboardcharts,spotify,AppleMusic,ChartData,popcrave,xxlmag,complex,RollingStone,Variety,Pitchfork

# -----------------------------------------------------------------------------
# Speech / event research profile (word-mention, will-X-say-Y markets)
# -----------------------------------------------------------------------------
# Top 5: official transcript sources + canonical primary speech archives.
#   c-span.org           - definitive US Congress / White House video archive
#   whitehouse.gov       - press briefings, statements, transcripts
#   transcripts.cnn.com  - structured speech transcripts (creative direct source)
